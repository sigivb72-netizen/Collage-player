<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Catches all gestures; sits above the video and under the controls. -->
    <View
        android:id="@+id/gestureArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/centerInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_round_overlay"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_grad_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/CtrlIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudio"
                style="@style/CtrlIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_music" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubs"
                style="@style/CtrlIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_subtitles" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMore"
                style="@style/CtrlIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_more" />
        </LinearLayout>

        <!-- center transport -->
        <LinearLayout
            android:id="@+id/centerBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrev"
                style="@style/CtrlIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_prev" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRew"
                style="@style/CtrlIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:icon="@drawable/ic_rew" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                style="@style/CtrlIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/overlay"
                app:icon="@drawable/ic_pause"
                app:iconSize="44dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFf"
                style="@style/CtrlIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:icon="@drawable/ic_ff" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/CtrlIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_next" />
        </LinearLayout>

        <!-- bottom bar -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_grad_bottom"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timeCur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:gravity="center"
                    android:text="0:00"
                    android:textColor="#FFFFFFFF" />

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/timeTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:gravity="center"
                    android:text="0:00"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLock"
                    style="@style/CtrlIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_lock" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRotate"
                    style="@style/CtrlIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_rotate" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRepeat"
                    style="@style/CtrlIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_repeat" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeed"
                    style="@style/CtrlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.00x" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPip"
                    style="@style/CtrlIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_pip" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAspect"
                    style="@style/CtrlIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_aspect" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnlock"
        style="@style/CtrlIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:backgroundTint="@color/overlay"
        android:visibility="gone"
        app:icon="@drawable/ic_lock" />
</FrameLayout>
